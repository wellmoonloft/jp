t;/string&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;43&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;key&amp;gt;&lt;/span&gt;PayloadUUID&lt;span style="color:#0550ae"&gt;&amp;lt;/key&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;44&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;string&amp;gt;&lt;/span&gt;301BFAB9-5324-43AD-AF0B-46B6C8FA0FED&lt;span style="color:#0550ae"&gt;&amp;lt;/string&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;45&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;key&amp;gt;&lt;/span&gt;PayloadVersion&lt;span style="color:#0550ae"&gt;&amp;lt;/key&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;46&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;integer&amp;gt;&lt;/span&gt;1&lt;span style="color:#0550ae"&gt;&amp;lt;/integer&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;47&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;key&amp;gt;&lt;/span&gt;PayloadType&lt;span style="color:#0550ae"&gt;&amp;lt;/key&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;48&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;string&amp;gt;&lt;/span&gt;Configuration&lt;span style="color:#0550ae"&gt;&amp;lt;/string&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;49&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;key&amp;gt;&lt;/span&gt;PayloadRemovalDisallowed&lt;span style="color:#0550ae"&gt;&amp;lt;/key&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;50&lt;/span&gt;&lt;span&gt; &lt;span style="color:#0550ae"&gt;&amp;lt;false/&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;51&lt;/span&gt;&lt;span&gt;&lt;span style="color:#0550ae"&gt;&amp;lt;/dict&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;52&lt;/span&gt;&lt;span&gt;&lt;span style="color:#0550ae"&gt;&amp;lt;/plist&amp;gt;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id="3-注意点"&gt;3. 注意点&lt;/h2&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&lt;strong&gt;VPNではありません：&lt;/strong&gt;&#10;暗号化DNSを設定するだけで、すべての通信がVPNトンネルを通るわけではありません。&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;プロキシ設定ではありません：&lt;/strong&gt;&#10;プロキシノード、ルーティングルール、通信の振り分けルールは設定していません。&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;ルート証明書ではありません：&lt;/strong&gt;&#10;独自の認証局証明書をインストールするものではありません。&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;MDMへの登録ではありません：&lt;/strong&gt;&#10;組織のMDMサービスに端末を登録する設定は含まれていません。&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;ネットワーク制限を回避するものではありません：&lt;/strong&gt;&#10;DoHはDNSクエリの通信を保護するものであり、アクセス先のWebサイトに接続できることを保証するものでも、プロキシの代わりになるものでもありません。&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;広告を自動的にブロックするものではありません：&lt;/strong&gt;&#10;広告ブロックには、必要に応じてAdGuardなどを組み合わせる必要があります。&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;h2 id="4-削除方法"&gt;4. 削除方法&lt;/h2&gt;&#10;&lt;p&gt;ネットワークに問題が発生した場合や、元のDNS設定に戻したい場合は、iPhoneの設定画面からインストール済みの構成プロファイルを削除してください。削除後のDNSの動作は、iOS、接続中のネットワーク、プロキシアプリなどの設定によって決まります。&lt;/p&gt;</description></item></channel></rss>